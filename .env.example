# Copiar a .env y completar. Nunca commitear el .env real (ya está en .gitignore).
# demo.ts NO necesita ninguna variable de este archivo: corre las herramientas
# sin modelo. Estas variables solo las usa src/server.ts (el chat).

GEMINI_API_KEY=               # clave de la API de Google Gemini; nunca va en el repo, el front ni los logs
GEMINI_MODEL=                 # ej. gemini-flash-lite-latest; si se omite, el código usa ese default (el nivel más económico de la familia Gemini)
MAX_TOKENS_POR_SESION=        # tope de tokens acumulados por sesión de chat; si se omite, el código aplica un default conservador
MAX_COSTO_USD_POR_SESION=     # tope de costo en USD por sesión, alternativo/adicional al tope de tokens
PORT=                         # puerto del backend; si se omite, default 3000
